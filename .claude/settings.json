{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run pyright*)",
      "Bash(uv run pssim*)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv tree*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch*)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Read(src/**)",
      "Read(tests/**)",
      "Read(docs/**)",
      "Read(machines/**)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(docs/**)",
      "Edit(machines/**)"
    ],

    "ask": [
      "Bash(git push *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(pip install *)",
      "Bash(uv run python setup_dist.py*)"
    ],

    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(certs/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(**/.env*)",
      "Edit(certs/**)",
      "Edit(uv.lock)",
      "Edit(assets/cache/**)",
      "Edit(models/**/*.step)",
      "Edit(models/**/*.stp)",
      "Edit(models/**/*.iges)",
      "Edit(models/**/*.igs)",
      "Edit(models/**/*.jt)",
      "Edit(models/**/*.sldprt)",
      "Edit(models/**/*.sldasm)",
      "Edit(recordings/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fdx*)",
      "Bash(rm -rf *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(iwr * | iex)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-lint.sh",
            "statusMessage": "Formatting and linting the changed file",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-bash.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },

  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 45
}
